{
  // The API (Rust, server/stam-worker) on workers.dev. The app is on Cloudflare Pages at
  // SITE_ORIGIN, another account, and calls it cross-site (docs/deploy.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stam",
  "main": "server/stam-worker/build/index.js",
  "compatibility_date": "2026-10-01",
  // Served at https://stam.<account subdomain>.workers.dev (API_ORIGIN below); no preview hosts.
  "workers_dev": true,
  "preview_urls": false,
  "build": {
    "command": "cd server/stam-worker && worker-build --release",
  },
  "vars": {
    "ENVIRONMENT": "production",
    // The app (Pages): the only other site allowed to call the API; sign-in returns there.
    "SITE_ORIGIN": "https://stam.mirzalabs.in",
    // This Worker's own address; Google's redirect URI is API_ORIGIN/api/auth/google/callback.
    "API_ORIGIN": "https://stam.stammirzalabs.workers.dev",
    "GOOGLE_AUTH_URL": "https://accounts.google.com/o/oauth2/v2/auth",
    "GOOGLE_TOKEN_URL": "https://oauth2.googleapis.com/token",
    "GOOGLE_USERINFO_URL": "https://openidconnect.googleapis.com/v1/userinfo",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stam",
      // From `wrangler d1 create stam` (docs/deploy.md); local dev and tests ignore it.
      "database_id": "4f812116-0e72-41a3-8731-e5d28438c086",
      "migrations_dir": "server/migrations",
    },
  ],
  // Per-IP limits per Cloudflare location per 60 s (server/stam-worker/src/ratelimit.rs). Ids must
  // be unique in the Cloudflare account.
  "ratelimits": [
    { "name": "LIMIT_API", "namespace_id": "7101", "simple": { "limit": 120, "period": 60 } },
    { "name": "LIMIT_PHOTOS", "namespace_id": "7102", "simple": { "limit": 600, "period": 60 } },
    { "name": "LIMIT_LINKS", "namespace_id": "7103", "simple": { "limit": 30, "period": 60 } },
    { "name": "LIMIT_AUTH", "namespace_id": "7104", "simple": { "limit": 20, "period": 60 } },
  ],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "stam-photos" }],
  "durable_objects": {
    "bindings": [{ "name": "TREE_ROOM", "class_name": "TreeRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TreeRoom"] }],
}
