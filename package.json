    "jspdf": "^4.2.1",
    "lenis": "^1.3.27",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.2",
    "react-router": "^8.5.0",
    "svg2pdf.js": "^2.8.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
